<Window x:Class="WiringKitSOP.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Wiring KIT SOP Dashboard – DSE G4501" Height="960" Width="1550" MinHeight="820" MinWidth="1250"
 WindowStartupLocation="CenterScreen" Background="#EAF2F9">
 <Window.Resources>
  <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="5"/></Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#57728D"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="ValueText" TargetType="TextBlock"><Setter Property="Foreground" Value="#173B60"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="#EAF2F9"/><Setter Property="Foreground" Value="#244A70"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="4"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#103858"><DockPanel Margin="14,0"><TextBlock Text="⚙  WIRING KIT SOP DASHBOARD" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="ModeLabel" Text="SIMULATION MODE" Foreground="#A9F5C8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
  <Grid Grid.Row="1" Background="#F8FBFE" Margin="0,0,0,5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,0"><TextBlock Text="GREAVES COTTON LTD" FontSize="20" FontWeight="Bold" Foreground="#16466F"/><TextBlock Text="Industrial Wiring Assembly" Foreground="#607B94"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CONTROLLER MODEL" Style="{StaticResource SmallLabel}"/><TextBlock Text="DSE G4501" Style="{StaticResource ValueText}" FontSize="17"/></StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="DATE &amp; TIME" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="DateTimeText" Style="{StaticResource ValueText}"/></StackPanel>
   <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="PLC STATUS" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="PlcStatusText" Text="● Demo Connected" Foreground="#15945B" FontWeight="Bold"/></StackPanel>
   <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="OPERATOR / TASK ID" Style="{StaticResource SmallLabel}"/><TextBlock Text="OP-001  |  WIRING-001" Style="{StaticResource ValueText}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="8">
   <Grid.RowDefinitions><RowDefinition Height="5*"/><RowDefinition Height="Auto"/><RowDefinition Height="2.1*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
    <!-- Left SOP instruction panel -->
    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <DockPanel><TextBlock x:Name="StepTitle" Text="Step 1 of 4" FontSize="21" FontWeight="Bold" Foreground="#174E86"/><Border Background="#DDF5E8" CornerRadius="12" Padding="10,5"><TextBlock x:Name="StepState" Text="WIRING IN PROGRESS" Foreground="#087A49" FontWeight="Bold" FontSize="11"/></Border></DockPanel>
      <ProgressBar x:Name="StepProgress" Height="7" Margin="0,12,0,14" Minimum="0" Maximum="100" Value="0" Foreground="#1685E8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="Wire Color" Style="{StaticResource ValueText}"/><TextBlock x:Name="WireColorText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"/>
       <TextBlock Grid.Row="1" Text="Ferrule No." Style="{StaticResource ValueText}"/><TextBlock x:Name="FerruleText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"/>
       <TextBlock Grid.Row="2" Text="Source Terminal" Style="{StaticResource ValueText}"/><TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}"/>
       <TextBlock Grid.Row="3" Text="Target Pin" Style="{StaticResource ValueText}"/><TextBlock x:Name="TargetText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}"/>
       <TextBlock Grid.Row="4" Text="Connector / Slot" Style="{StaticResource ValueText}"/><TextBlock x:Name="ConnectorText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}"/>
      </Grid>
      <Separator Margin="0,8"/><TextBlock Text="▣  INSTRUCTIONS" FontSize="15" FontWeight="Bold" Foreground="#174E86" Margin="0,4,0,8"/>
      <ItemsControl x:Name="InstructionList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="•  {Binding}" TextWrapping="Wrap" Margin="2,4" Foreground="#345A7C" FontSize="13"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Separator Margin="0,10"/><TextBlock Text="✔  EXPECTED FEEDBACK" FontSize="14" FontWeight="Bold" Foreground="#128050"/><TextBlock x:Name="ExpectedText" Text="Connection OK + Tie OK" Margin="4,8"/>
      <Separator Margin="0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="ATTEMPT" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="AttemptText" Text="1 / 3" FontWeight="Bold"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="STEP STATUS" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="FeedbackText" Text="Waiting" Foreground="#D99A00" FontWeight="Bold"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="NEXT STEP" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="NextStepText" Text="Step 2" FontWeight="Bold"/></StackPanel>
      </Grid>
     </StackPanel></ScrollViewer>
    </Border>
    <!-- Center controller animation -->
    <Border Grid.Column="1" Style="{StaticResource PanelCard}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Background="#1676CF" CornerRadius="5" Padding="12,7"><TextBlock Text="CONTROLLER VIEW" Foreground="White" FontWeight="Bold"/></Border><Border Background="#EAF2F9" CornerRadius="5" Padding="12,7" Margin="5,0"><TextBlock Text="LIVE WIRING ANIMATION" Foreground="#315A7D" FontWeight="Bold"/></Border></StackPanel>
      <Border Grid.Row="1" Background="#DDE7EF" CornerRadius="8" Padding="10">
       <Viewbox Stretch="Uniform"><Canvas x:Name="ControllerCanvas" Width="720" Height="480" Background="#DDE7EF">
        <Rectangle Canvas.Left="25" Canvas.Top="20" Width="670" Height="280" RadiusX="18" RadiusY="18" Fill="#293744" Stroke="#15232D" StrokeThickness="5"/>
        <Rectangle Canvas.Left="55" Canvas.Top="42" Width="610" Height="110" RadiusX="8" RadiusY="8" Fill="#394B59" Stroke="#71818C" StrokeThickness="2"/>
        <Rectangle Canvas.Left="220" Canvas.Top="62" Width="280" Height="70" RadiusX="5" RadiusY="5" Fill="#101B24" Stroke="#0A1118" StrokeThickness="4"/>
        <Rectangle Canvas.Left="245" Canvas.Top="78" Width="230" Height="38" Fill="#A5C9A6" Stroke="#59765D"/>
        <TextBlock Canvas.Left="255" Canvas.Top="87" Text="DSE G4501" Foreground="#173B60" FontSize="15" FontWeight="Bold"/>
        <TextBlock Canvas.Left="535" Canvas.Top="90" Text="CONTROL MODULE" Foreground="#DDE8EF" FontSize="14"/>
        <Rectangle Canvas.Left="95" Canvas.Top="180" Width="530" Height="88" RadiusX="5" RadiusY="5" Fill="#17252F" Stroke="#0C151B" StrokeThickness="3"/>
        <Rectangle Canvas.Left="110" Canvas.Top="194" Width="500" Height="56" RadiusX="3" RadiusY="3" Fill="#3B694B" Stroke="#85A88B" StrokeThickness="2"/>
        <TextBlock Canvas.Left="120" Canvas.Top="257" Text="J1 CONNECTOR  •  PIN 1–8" Foreground="#F5F8FA" FontSize="13" FontWeight="Bold"/>
        <ItemsControl x:Name="PinVisuals" Canvas.Left="125" Canvas.Top="205"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="48" Height="28" Margin="2" Background="#9CAEB7" BorderBrush="#17252F" BorderThickness="2" CornerRadius="3"><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#182A35"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Path x:Name="WirePath" Data="M 150,450 C 150,370 150,320 150,245 C 220,245 350,245 510,245" Stroke="#E53935" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="2,1" StrokeDashOffset="90"/>
        <Ellipse x:Name="ConnectionDot" Canvas.Left="493" Canvas.Top="228" Width="26" Height="26" Fill="#F4B400" Stroke="White" StrokeThickness="3" Visibility="Hidden"/>
        <Rectangle x:Name="TieGun" Canvas.Left="460" Canvas.Top="165" Width="85" Height="40" RadiusX="8" RadiusY="8" Fill="#263F58" Stroke="#0E2438" StrokeThickness="3" Visibility="Hidden"/>
        <TextBlock Canvas.Left="475" Canvas.Top="177" Text="TIE GUN" Foreground="White" FontSize="12" FontWeight="Bold"/>
        <TextBlock Canvas.Left="40" Canvas.Top="455" Text="WIRE SOURCE  TB-01" Foreground="#315A7D" FontSize="13" FontWeight="Bold"/>
        <Border Canvas.Left="565" Canvas.Top="340" Background="#FFFFFF" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="LIVE SIGNAL" FontWeight="Bold"/><TextBlock x:Name="AnimationStatus" Text="Waiting for PLC..." Foreground="#607B94"/></StackPanel></Border>
       </Canvas></Viewbox>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"><TextBlock Text="●" Foreground="#E53935" FontSize="18"/><TextBlock Text=" Red" Margin="3,3,14,0"/><TextBlock Text="●" Foreground="#1976D2" FontSize="18"/><TextBlock Text=" Blue" Margin="3,3,14,0"/><TextBlock Text="●" Foreground="#F4B400" FontSize="18"/><TextBlock Text=" Yellow" Margin="3,3,14,0"/><TextBlock Text="●" Foreground="#15945B" FontSize="18"/><TextBlock Text=" Completed" Margin="3,3,0,0"/></StackPanel>
     </Grid>
    </Border>
    <!-- Right status panel -->
    <StackPanel Grid.Column="2">
     <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="CONNECTION STATUS" FontSize="15" FontWeight="Bold" Foreground="#174E86" Margin="0,0,0,10"/><TextBlock x:Name="ConnectionStatus" Text="●  Waiting for wire" Margin="3,5"/><TextBlock x:Name="TieStatus" Text="●  Tie gun idle" Margin="3,5"/><TextBlock x:Name="CompleteStatus" Text="●  Stage pending" Margin="3,5"/></StackPanel></Border>
     <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="TORQUE / TIE PROCESS" FontSize="15" FontWeight="Bold" Foreground="#174E86"/><ProgressBar x:Name="TorqueProgress" Height="16" Margin="0,15" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="TorquePercent" Text="0%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="TorqueText" Text="Waiting for PLC feedback..." HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="STAGE OVERVIEW" FontSize="15" FontWeight="Bold" Foreground="#174E86"/><ItemsControl x:Name="StageList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="2,4" Foreground="#345A7C"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
   </Grid>
   <!-- Controls -->
   <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="5"><WrapPanel VerticalAlignment="Center">
    <Button x:Name="StartButton" Content="▶  Start Task" Background="#07834D" Click="StartButton_Click"/>
    <Button x:Name="PauseButton" Content="Ⅱ  Pause" Background="#6B8298" Click="PauseButton_Click"/>
    <Button x:Name="ResumeButton" Content="▶  Resume" Background="#557FA8" Click="ResumeButton_Click"/>
    <Button Content="■  Abort" Background="#E53945" Click="AbortButton_Click"/>
    <Button Content="↻  Reset" Background="#70869A" Click="ResetButton_Click"/>
    <Button Content="⟳  Retry" Background="#1976D2" Click="RetryButton_Click"/>
    <Button Content="PLC Connect" Background="#174E86" Click="ConnectButton_Click"/>
    <CheckBox x:Name="DemoModeCheck" Content="Demo Mode" IsChecked="True" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" Checked="DemoModeCheck_Changed" Unchecked="DemoModeCheck_Changed"/>
    <Button Content="Export Excel" Background="#16845A" Click="ExcelButton_Click"/>
    <Button Content="Export Word" Background="#315A7D" Click="WordButton_Click"/>
   </WrapPanel></Border>
   <!-- Logs and progress -->
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource PanelCard}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="RECENT EVENTS" FontWeight="Bold" FontSize="14" Foreground="#174E86" Margin="0,0,0,8"/><DataGrid x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="90"/><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="150"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource PanelCard}"><StackPanel><DockPanel><TextBlock Text="TASK PROGRESS" FontWeight="Bold" FontSize="14" Foreground="#174E86"/><TextBlock x:Name="ProgressPercent" Text="0%" FontWeight="Bold" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="TaskProgress" Height="16" Margin="0,12" Minimum="0" Maximum="100"/><UniformGrid Columns="4" Margin="0,8"><StackPanel><TextBlock Text="TOTAL" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="TotalStepsText" Text="0" FontSize="20" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="COMPLETED" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="CompletedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#15945B"/></StackPanel><StackPanel><TextBlock Text="REMAINING" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="RemainingText" Text="0" FontSize="20" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="ATTEMPT" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="CurrentAttemptText" Text="1 / 3" FontSize="20" FontWeight="Bold"/></StackPanel></UniformGrid><TextBlock Text="PLC input bytes are mapped in Configuration/wiring-steps.json" Foreground="#607B94" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
